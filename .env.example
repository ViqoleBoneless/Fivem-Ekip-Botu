# ==============================================================================
# DISCORD BOTU - ÇEVRE DEĞİŞKENLERİ (.env)
# ==============================================================================
# Bu dosyayı kopyalayarak ".env" adında bir dosya oluşturun ve hassas bilgilerinizi girin.
# Ekip ismi, logo yolu, kanal/rol ID'leri ve diğer tüm ayarlar "config.json" dosyasındadır.
# ==============================================================================

# [ZORUNLU] Discord Bot Bilgileri
# Discord Developer Portal > Bot sekmesinden alınan bot tokeni
TOKEN=BURAYA_BOT_TOKEN_YAZIN

# Discord Developer Portal > General Information sekmesinden Application (Client) ID
CLIENT_ID=BURAYA_CLIENT_ID_YAZIN

# Botun çalışacağı Discord Sunucu (Guild) ID'si
GUILD_ID=BURAYA_SUNUCU_ID_YAZIN

# ==============================================================================
# WEB YÖNETİM PANELİ & DISCORD OAUTH2 (Opsiyonel / Web Panel için)
# ==============================================================================
# Web Paneli Portu (Varsayılan: 3000)
WEB_PORT=3000

# Discord Developer Portal > OAuth2 > General sekmesinden Client Secret
OAUTH_CLIENT_SECRET=BURAYA_OAUTH_CLIENT_SECRET_YAZIN

# Web Paneli Oturum Güvenlik Anahtarı (Rastgele bir metin yazabilirsiniz)
SESSION_SECRET=super_secret_session_key_buraya

# ==============================================================================
# VERİTABANI (Opsiyonel)
# ==============================================================================
# MongoDB Bağlantı Adresi (Opsiyonel - Boş bırakırsanız yerel SQLite kullanılır)
MONGODB_URI=
